<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tinygiant.worker</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>-m</string>
        <string>tinygiant.worker</string>
        <string>--config</string>
        <string>/Users/jerrybecker/.tinygiant/worker-config.json</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/jerrybecker/tinygiant</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/jerrybecker/tinygiant</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/Users/jerrybecker/.tinygiant/logs/worker.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jerrybecker/.tinygiant/logs/worker.err</string>
</dict>
</plist>
